    "demo": "node scripts/create-demo.mjs",
    "inspect": "node scripts/inspect.mjs",
    "package": "node scripts/package.mjs",
    "test:transfer": "node scripts/smoke-transfer.mjs",
    "test:textures": "node scripts/smoke-textures.mjs",
    "test:models": "node scripts/smoke-models.mjs",
    "test:archive": "node scripts/smoke-archive.mjs",
    "demo:preservation": "node scripts/demo-preservation.mjs",
    "test:updates": "node --test tests/updates.test.js",
    "test:updates-desktop": "node scripts/smoke-updates.mjs",
